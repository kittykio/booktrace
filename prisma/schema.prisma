// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  READ
  PAUSED
  DNF
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reviews      Review[]
  goals        ReadingGoal[]
}

model Review {
  id         String        @id @default(cuid())
  bookId     String
  title      String
  author     String
  price      String        @default("")
  publisher  String        @default("")
  published  String        @default("")
  image      String
  status     ReadingStatus @default(WANT_TO_READ)
  rating     Int?
  tags       String[]      @default([])
  favorite   Boolean       @default(false)
  startedAt  DateTime?
  finishedAt DateTime?
  memo       String        @default("")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([userId, favorite])
}

model ReadingGoal {
  id        String   @id @default(cuid())
  year      Int
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}
